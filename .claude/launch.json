{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/server/src/main.ts",
        "--port",
        "3000"
      ],
      "port": 3000,
      "env": {
        "AI_DIALOG": "local",
        "AI_GENERATOR": "local",
        "LOCAL_AI_URL": "http://localhost:11434",
        "LOCAL_AI_MODEL": "dps-gemma3"
      }
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "-w",
        "@dps/app",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
