{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages",
    "apps/server",
    "apps/app/src/ekg.ts",
    "apps/app/src/caseform.ts",
    "apps/app/test"
  ]
}
